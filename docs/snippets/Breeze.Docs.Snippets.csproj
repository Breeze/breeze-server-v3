<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The C# shown in docs/guide lives here so that the compiler checks it. Every fenced
         C# block in the guide is a [!code-csharp[](...#Region)] reference into these files;
         DOCS.md explains the arrangement. Nothing runs this: it is compiled, never executed,
         and the guide shows only what is inside a #region. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Breeze.Docs.Snippets</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Documentation, not a shipping package, and not a thing to run. -->
    <IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost>
    <!-- CS1591 is enforced on src/ but these are examples, not a public API. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
  </ItemGroup>

  <!-- Against the code in this repo, so a breaking change here fails the docs build too. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Breeze.AspNetCore.NetCore\Breeze.AspNetCore.NetCore.csproj" />
    <ProjectReference Include="..\..\src\Breeze.Persistence.EFCore\Breeze.Persistence.EFCore.csproj" />
  </ItemGroup>

</Project>
