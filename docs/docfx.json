{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "api-landing/**",
          "snippets/**"
        ]
      },
      {
        "_comment": "The landing page for the generated API section. docs/api/ is generated and gitignored, so the source sits outside it and is published into it. Without this, /api/ has no index and 404s - DocFX's own nav resolves 'api/' through the toc at runtime, which a direct link cannot do.",
        "files": [
          "index.md"
        ],
        "src": "api-landing",
        "dest": "api"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Breeze Server for .NET",
      "_appTitle": "Breeze Server for .NET",
      "_appFooter": "Breeze Server 8.0.0 - Copyright &copy; IdeaBlade 2012-2026",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}
