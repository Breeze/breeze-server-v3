<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- No per-project .exe: run through the Microsoft-signed dotnet.exe instead. Windows
         application control (Smart App Control, WDAC) blocks freshly built unsigned .exe files. -->
    <UseAppHost>false</UseAppHost>
    <!-- A test host. Never packed; see Controllers/TestDbController.cs. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;NHIBERNATE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;NHIBERNATE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Breeze.AspNetCore.NetCore\Breeze.AspNetCore.NetCore.csproj" />
    <ProjectReference Include="..\..\src\Breeze.Persistence.NH\Breeze.Persistence.NH.csproj" />
    <ProjectReference Include="..\Model_Inheritance_NH\Model_Inheritance_NH.csproj" />
    <ProjectReference Include="..\Model_NorthwindIB_NH\Model_NorthwindIB_NH.csproj" />
    <ProjectReference Include="..\Model_Produce_NH\Model_Produce_NH.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="breezeTests\breeze\breeze.debug.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
