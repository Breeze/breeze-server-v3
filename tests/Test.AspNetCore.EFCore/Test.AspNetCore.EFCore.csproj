<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- No per-project .exe: run through the Microsoft-signed dotnet.exe instead. Windows
         application control (Smart App Control, WDAC) blocks freshly built unsigned .exe files. -->
    <UseAppHost>false</UseAppHost>
    <!-- A test host. Never packed; see Controllers/TestDbController.cs. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);EFCORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Backs Controllers/ExpandPolicyController.cs, whose demo model needs a real EF provider
         for Include but no tables in BreezeTestDb. Test host only. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Test against the code in this repo, not the published NuGet packages. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Breeze.AspNetCore.NetCore\Breeze.AspNetCore.NetCore.csproj" />
    <ProjectReference Include="..\..\src\Breeze.Persistence.EFCore\Breeze.Persistence.EFCore.csproj" />
    <ProjectReference Include="..\Model_Inheritance.EFCore\Model_Inheritance.EFCore.csproj" />
    <ProjectReference Include="..\Model_NorthwindIB_CF.EFCore\Model_NorthwindIB_CF.EFCore.csproj" />
    <ProjectReference Include="..\Model_ProduceTPH_CF.EFCore\Model_ProduceTPH_CF.EFCore.csproj" />
  </ItemGroup>

</Project>
